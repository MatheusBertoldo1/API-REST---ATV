{
  "openapi": "3.0.0",
  "info": {
    "title": "Darkhorse API - Sistema de Orçamento para Filmes",
    "version": "1.0.0",
    "description": "Documentacao interativa da API REST para gestao de orcamentos cinematograficos do projeto Darkhorse"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor Local de Desenvolvimento"
    }
  ],
  "paths": {
    "/budgets": {
      "get": {
        "summary": "Listar todos os orcamentos",
        "tags": ["Budgets"],
        "responses": {
          "200": {
            "description": "Lista de orcamentos retornada com sucesso"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      },
      "post": {
        "summary": "Cadastrar novo orcamento",
        "tags": ["Budgets"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBudgetDTO"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Orcamento criado com sucesso" },
          "400": { "description": "Dados invalidos ou campos obrigatorios ausentes" },
          "500": { "description": "Erro interno no servidor" }
        }
      }
    },
    "/budgets/{id}": {
      "get": {
        "summary": "Buscar orcamento por ID",
        "tags": ["Budgets"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Orcamento encontrado" },
          "404": { "description": "Orcamento nao encontrado" },
          "500": { "description": "Erro interno no servidor" }
        }
      },
      "put": {
        "summary": "Atualizar dados de um orcamento",
        "tags": ["Budgets"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBudgetDTO"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Orcamento atualizado com sucesso" },
          "404": { "description": "Orcamento nao encontrado" },
          "500": { "description": "Erro interno no servidor" }
        }
      },
      "delete": {
        "summary": "Remover orcamento por ID",
        "tags": ["Budgets"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "204": { "description": "Orcamento removido com sucesso" },
          "404": { "description": "Orcamento nao encontrado" },
          "500": { "description": "Erro interno no servidor" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Budget": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "movieTitle": { "type": "string", "example": "Batman" },
          "department": { "type": "string", "example": "Efeitos Especiais" },
          "allocatedAmount": { "type": "number", "example": 150000.00 },
          "spentAmount": { "type": "number", "example": 25000.00 },
          "status": { "type": "string", "example": "APPROVED" },
          "createdAt": { "type": "string", "example": "2026-10-04T12:00:00.000Z" },
          "updatedAt": { "type": "string", "example": "2026-10-04T12:00:00.000Z" }
        }
      },
      "CreateBudgetDTO": {
        "type": "object",
        "required": ["movieTitle", "department", "allocatedAmount"],
        "properties": {
          "movieTitle": { "type": "string", "example": "Batman" },
          "department": { "type": "string", "example": "Efeitos Especiais" },
          "allocatedAmount": { "type": "number", "example": 150000.00 },
          "spentAmount": { "type": "number", "example": 0.00 },
          "status": { "type": "string", "example": "PENDING" }
        }
      },
      "UpdateBudgetDTO": {
        "type": "object",
        "properties": {
          "movieTitle": { "type": "string", "example": "Batman: O Cavaleiro das Trevas" },
          "department": { "type": "string", "example": "Efeitos Especiais" },
          "allocatedAmount": { "type": "number", "example": 200000.00 },
          "spentAmount": { "type": "number", "example": 50000.00 },
          "status": { "type": "string", "example": "APPROVED" }
        }
      }
    }
  }
}